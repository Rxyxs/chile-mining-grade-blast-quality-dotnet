<Window x:Class="ChileMining.DesktopApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChileMining.DesktopApp"
        mc:Ignorable="d"
        Title="Control de Leyes y Tronadura - Chile Mining" Height="640" Width="920"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Margin" Value="0,8,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Width" Value="220" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Width" Value="220" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,20,0,0" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="#B3452D" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="⛏️ Control de Leyes y Calidad de Tronadura" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="ML.NET local -- estimación de ley de cobre y calidad de fragmentación de tronadura" Foreground="#666666" />
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="Control de Leyes">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="Profundidad (m)" />
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="ProfundidadTextBox" Text="200" />

                    <Label Grid.Row="1" Grid.Column="0" Content="Unidad geológica" />
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="UnidadGeologicaComboBox" SelectedIndex="0">
                        <ComboBoxItem Content="Porfido Cu-Mo" />
                        <ComboBoxItem Content="Skarn" />
                        <ComboBoxItem Content="Brecha Hidrotermal" />
                        <ComboBoxItem Content="Andesita Alterada" />
                    </ComboBox>

                    <Label Grid.Row="2" Grid.Column="0" Content="Tipo de alteración" />
                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="TipoAlteracionComboBox" SelectedIndex="0">
                        <ComboBoxItem Content="Potasica" />
                        <ComboBoxItem Content="Filica" />
                        <ComboBoxItem Content="Propilitica" />
                        <ComboBoxItem Content="Argilica" />
                    </ComboBox>

                    <Label Grid.Row="3" Grid.Column="0" Content="Densidad (gr/cm3)" />
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="DensidadTextBox" Text="2.75" />

                    <Label Grid.Row="4" Grid.Column="0" Content="Resistividad (ohm-m)" />
                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="ResistividadTextBox" Text="40" />

                    <Label Grid.Row="5" Grid.Column="0" Content="Distancia a falla (m)" />
                    <TextBox Grid.Row="5" Grid.Column="1" x:Name="DistanciaFallaTextBox" Text="50" />

                    <Button Grid.Row="6" Grid.Column="1" x:Name="EstimarLeyButton" Content="Estimar ley de cobre" Click="EstimarLeyButton_Click" />

                    <Border Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,16,0,0" Padding="12"
                            Background="#F4EFE8" BorderBrush="#D8CDBB" BorderThickness="1" VerticalAlignment="Top">
                        <TextBlock x:Name="ResultadoLeyTextBlock" Text="Ingresa los datos de sondaje y presiona Estimar." TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Diseño de Tronadura">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="Burden (m)" />
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="BurdenTextBox" Text="5" />

                    <Label Grid.Row="1" Grid.Column="0" Content="Espaciamiento (m)" />
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="EspaciamientoTextBox" Text="6" />

                    <Label Grid.Row="2" Grid.Column="0" Content="Factor de potencia (kg/ton)" />
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="FactorPotenciaTextBox" Text="0.30" />

                    <Label Grid.Row="3" Grid.Column="0" Content="Dureza de roca (MPa)" />
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="DurezaRocaTextBox" Text="120" />

                    <Label Grid.Row="4" Grid.Column="0" Content="Diámetro de perforación (mm)" />
                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="DiametroTextBox" Text="250" />

                    <Button Grid.Row="5" Grid.Column="1" x:Name="PredecirFragmentacionButton" Content="Predecir fragmentación" Click="PredecirFragmentacionButton_Click" />

                    <Border Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,16,0,0" Padding="12"
                            Background="#F4EFE8" BorderBrush="#D8CDBB" BorderThickness="1" VerticalAlignment="Top">
                        <TextBlock x:Name="ResultadoFragmentacionTextBlock" Text="Ingresa el diseño de tronadura y presiona Predecir." TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
